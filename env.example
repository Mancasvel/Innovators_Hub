# ============================================
# INNOVATORS HUB - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ============================================
# DATABASE - MongoDB Atlas
# ============================================
# Get from: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/innovators-hub?retryWrites=true&w=majority

# ============================================
# AUTHENTICATION - NextAuth
# ============================================
# Production: Use your actual domain
NEXTAUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
# IMPORTANT: Change this in production!
NEXTAUTH_SECRET=your-super-secret-key-min-32-characters-change-in-production


# ============================================
# PAYMENTS - Stripe
# ============================================
# Get from: https://dashboard.stripe.com/test/apikeys
# Use TEST keys for development (sk_test_...)
STRIPE_SECRET_KEY=sk_test_51234567890abcdefghijklmnopqrstuvwxyz
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51234567890abcdefghijklmnopqrstuvwxyz

# Stripe Webhook Secret
# Get from: https://dashboard.stripe.com/test/webhooks
# Create endpoint: https://your-domain.com/api/stripe/webhook
# Events to listen:
#   - checkout.session.completed
#   - customer.subscription.created
#   - customer.subscription.updated
#   - customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_1234567890abcdefghijklmnopqrstuvwxyz

# Stripe Membership Product
# Create annual subscription product in Stripe Dashboard
# Copy the Price ID (starts with price_...)
STRIPE_MEMBERSHIP_PRICE_ID=price_1234567890abcdefghijk

# Legacy variable (same as STRIPE_WEBHOOK_SECRET)
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_1234567890abcdefghijklmnopqrstuvwxyz

# ============================================
# EMAIL - Gmail SMTP
# ============================================
# How to get Gmail App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification (required)
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Select "Mail" and "Other (Custom name)"
# 5. Name it "Innovators Hub"
# 6. Copy the 16-character password (no spaces)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=noreply@unsent.app

# ============================================
# IMAGE UPLOAD - Uploadthing
# ============================================
# Get from: https://uploadthing.com/dashboard
# 1. Create account with GitHub
# 2. Create new project: "Innovators Hub"
# 3. Go to API Keys section
# 4. Copy both keys
UPLOADTHING_SECRET=sk_live_1234567890abcdefghijklmnopqrstuvwxyz
UPLOADTHING_APP_ID=your_app_id_here

# ============================================
# SECURITY
# ============================================
# HMAC Secret for QR Code signatures
# Generate with: openssl rand -base64 32
# IMPORTANT: Must be at least 32 characters!
SECRET_TICKET_KEY=your-hmac-secret-for-ticket-signatures-minimum-32-characters-required

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ============================================
# OPTIONAL: Advanced Configuration
# ============================================
# Enable/disable features
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
# NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Logging level
# LOG_LEVEL=info

# ============================================
# NOTES FOR PRODUCTION
# ============================================
# 1. Change NEXT_PUBLIC_APP_URL to your domain
# 2. Change NEXTAUTH_URL to your domain
# 3. Generate new NEXTAUTH_SECRET
# 4. Generate new SECRET_TICKET_KEY
# 5. Use Stripe LIVE keys (sk_live_... and pk_live_...)
# 6. Update Stripe webhook URL to production domain
# 7. Verify domain in Resend
# 8. Use production Uploadthing keys
# 9. Whitelist your production IPs in MongoDB Atlas
# 10. Enable HTTPS only in production

